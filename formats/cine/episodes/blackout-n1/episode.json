 "lines": [
  {
   "id": "L1",
   "voice": "n",
   "text": "Ta mère frappe à ta porte.",
   "keywords": [
    "MÈRE"
   ],
   "gap": 0.75
  },
  {
   "id": "L2",
   "voice": "n",
   "text": "Et tu sais... que ce n'est pas elle.",
   "keywords": [
    "ELLE"
   ],
   "gap": 0.75
  },
  {
   "id": "L3",
   "voice": "n",
   "text": "Trois heures plus tôt.",
   "keywords": [
    "TÔT"
   ],
   "gap": 0.45
  },
  {
   "id": "L4",
   "voice": "n",
   "text": "Imagine. Minuit pile.",
   "keywords": [
    "MINUIT"
   ],
   "gap": 0.25
  },
  {
   "id": "L5",
   "voice": "n",
   "text": "Toute la ville s'éteint. D'un coup.",
   "keywords": [
    "S'ÉTEINT"
   ],
   "gap": 0.55
  },
  {
   "id": "L6",
   "voice": "n",
   "text": "Plus de courant. Plus de réseau.",
   "keywords": [
    "RÉSEAU"
   ],
   "gap": 0.2
  },
  {
   "id": "L7",
   "voice": "n",
   "text": "Ton téléphone : 9 %.",
   "keywords": [
    "9"
   ],
   "gap": 0.3
  },
  {
   "id": "L8",
   "voice": "n",
   "text": "Un seul message arrive. Numéro inconnu.",
   "keywords": [
    "INCONNU"
   ],
   "gap": 0.35
  },
  {
   "id": "L9",
   "voice": "n",
   "text": "N'ouvre à personne cette nuit.",
   "keywords": [
    "PERSONNE"
   ],
   "gap": 0.2
  },
  {
   "id": "L10",
   "voice": "n",
   "text": "Même à quelqu'un que tu aimes.",
   "keywords": [
    "AIMES"
   ],
   "gap": 0.25
  },
  {
   "id": "L11",
   "voice": "n",
   "text": "Surtout... à quelqu'un que tu aimes.",
   "keywords": [
    "SURTOUT"
   ],
   "gap": 0.9
  },
  {
   "id": "L12",
   "voice": "n",
   "text": "Deux heures quarante.",
   "keywords": [
    "QUARANTE"
   ],
   "gap": 0.2
  },
  {
   "id": "L13",
   "voice": "n",
   "text": "Dehors, quelqu'un hurle ton prénom.",
   "keywords": [
    "HURLE"
   ],
   "gap": 0.25
  },
  {
   "id": "L14",
   "voice": "n",
   "text": "Puis plus rien.",
   "keywords": [
    "RIEN"
   ],
   "gap": 0.8
  },
  {
   "id": "L15",
   "voice": "n",
   "text": "Trois heures douze. On frappe.",
   "keywords": [
    "FRAPPE"
   ],
   "gap": 0.6
  },
  {
   "id": "M1",
   "voice": "m",
   "text": "Mon cœur... c'est maman. Ouvre-moi. Il fait si froid.",
   "gain_db": 3,
   "gap": 0.45
  },
  {
   "id": "L16",
   "voice": "n",
   "text": "Ta mère habite à 600 kilomètres.",
   "keywords": [
    "600"
   ],
   "gap": 0.3
  },
  {
   "id": "L17",
   "voice": "n",
   "text": "Et là... ton téléphone vibre.",
   "keywords": [
    "VIBRE"
   ],
   "gap": 0.2
  },
  {
   "id": "L18",
   "voice": "n",
   "text": "Sans réseau.",
   "keywords": [
    "RÉSEAU"
   ],
   "gap": 0.35
  },
  {
   "id": "M2",
   "voice": "m",
   "text": "Pourquoi tu n'ouvres pas ?",
   "gain_db": 3,
   "gap": 1.3
  },
  {
   "id": "L19",
   "voice": "n",
   "text": "Alors... tu ouvres ?",
   "keywords": [
    "OUVRES"
   ],
   "gap": 0.25
  },
  {
   "id": "L20",
   "voice": "n",
   "text": "Ou tu décroches ?",
   "keywords": [
    "DÉCROCHES"
   ],
   "gap": 0.5
  },
  {
   "id": "L21",
   "voice": "n",
   "text": "Écris 1 ou 2 en commentaire.",
   "keywords": [
    "1",
    "2"
   ],
   "gap": 0.15
  },
  {
   "id": "L22",
   "voice": "n",
   "text": "Le choix le plus voté décidera de la nuit 2.",
   "keywords": [
    "2"
   ],
   "gap": 0.3
  }
 ],
